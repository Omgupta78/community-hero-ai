# Vercel Environment Variables
# ──────────────────────────────────────────────────────────────────────────────
# Add these in the Vercel dashboard under:
#   Project → Settings → Environment Variables
# ──────────────────────────────────────────────────────────────────────────────

# Required: Google Gemini API key
# Get one free at: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_key_here

# Optional: Hard daily cap on Gemini calls (defaults to 180).
# When the cap is hit the app uses its heuristic fallback — demos never break.
GEMINI_DAILY_CAP=180

# Required: Firebase project ID — must match public/static/firebase-config.js
FIREBASE_PROJECT_ID=your_firebase_project_id

# Optional: Custom SQLite file path.
# Defaults to /tmp/community-hero.db (ephemeral — resets on cold start).
# For persistent storage, point this to a mounted volume or use Turso:
#   https://turso.tech
# DB_PATH=/tmp/community-hero.db
